# Set production values directly in Netlify, with Functions scope.
# Generate distinct long passwords and scrypt hashes using server/password.ts.
BOARD_PASSWORD_HASH=
CRAFTSMAN_PASSWORD_HASH=
# ISO timestamp with timezone. Missing or expired means no craftsman access.
CRAFTSMAN_ACCESS_UNTIL=
# Date of this single filter change, YYYY-MM-DD. Must be set before launch.
FILTER_EVENT_DATE=